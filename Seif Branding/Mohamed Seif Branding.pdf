                  <photoshop:LayerText>Mission &amp; Vision</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>My vision is to be choice number 1 in Egypt, the Middle East, a</photoshop:LayerName>
                  <photoshop:LayerText>My vision is to be choice number 1 in Egypt, the Middle East, and to be a choice for international productions interested in the region.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>My mission is providing unique creative content and production </photoshop:LayerName>
                  <photoshop:LayerText>My mission is providing unique creative content and production services through my experience in the advertising industry in all fields.</photoshop:LayerText>
               </rdf:li>
            </rdf:Bag>
         </photoshop:TextLayers>

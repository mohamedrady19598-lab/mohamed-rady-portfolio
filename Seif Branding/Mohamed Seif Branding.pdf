               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Who is Mohamed Seif?</photoshop:LayerName>
                  <photoshop:LayerText>Who is Mohamed Seif?</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Iâ€™m producer &amp; director from Egypt. I have more than 13 years o</photoshop:LayerName>
                  <photoshop:LayerText>Iâ€™m producer &amp; director from Egypt. I have more than 13 years of experience in the advertising industry as a producer and director in the field of film and television production. I have a new and different idea in the field of advertising, from the beginning of writing the story until the final implementation and directing, I want to spread my ads all over the world.  </photoshop:LayerText>
               </rdf:li>
            </rdf:Bag>
